# Cloudflare yanıt başlıkları — docker/nginx.conf'taki başlıkların karşılığı.
# /hackathon → hackathon.html eşlemesi ve 404.html wrangler.toml'daki [assets]
# ayarlarıyla yapılır; nginx'teki try_files / error_page kurallarına gerek yok.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Dosya adında içerik özeti (hash) olduğu için süresiz önbelleklenebilir.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/logos/*
  Cache-Control: public, max-age=2592000

/manifest.webmanifest
  Content-Type: application/manifest+json

