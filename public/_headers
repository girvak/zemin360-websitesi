# Cloudflare Pages yanıt başlıkları — docker/nginx.conf'taki başlıkların karşılığı.
# Pages, /hackathon → hackathon.html eşlemesini ve 404.html'i kendiliğinden yapar;
# nginx'teki try_files / error_page kurallarına burada gerek yok.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Dosya adında içerik özeti (hash) olduğu için süresiz önbelleklenebilir.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/logos/*
  Cache-Control: public, max-age=2592000

/manifest.webmanifest
  Content-Type: application/manifest+json

# *.pages.dev önizleme adresleri arama motorlarında zemin360.com ile yarışmasın.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
